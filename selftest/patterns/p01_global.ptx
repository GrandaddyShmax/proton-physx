// Rule: global accesses through 32-bit pointers (cvta.to.global, offsets incl. negative,
// vectors, sub-word loads, ld.global.nc, predicated stores, .ptr parameter attributes).
.version 4.1
.target sm_52
.address_size 32

.visible .entry test(
	.param .u32 .ptr .global .align 4 test_param_0,
	.param .u32 .ptr .global .align 4 test_param_1
)
{
	.reg .pred %p<4>;
	.reg .b16 %rs<4>;
	.reg .b32 %r<40>;

	ld.param.u32 %r1, [test_param_0];
	ld.param.u32 %r2, [test_param_1];
	cvta.to.global.u32 %r3, %r1;
	cvta.to.global.u32 %r4, %r2;
	mov.u32 %r5, %tid.x;
	shl.b32 %r6, %r5, 2;
	add.s32 %r7, %r4, %r6;
	add.s32 %r8, %r3, %r6;
	ld.global.u32 %r9, [%r7];
	ld.global.u32 %r10, [%r7+4];
	add.s32 %r11, %r9, %r10;
	st.global.u32 [%r8], %r11;
	add.s32 %r12, %r7, 4;
	ld.global.u32 %r13, [%r12+-4];
	st.global.u32 [%r8+128], %r13;
	setp.lt.u32 %p1, %r5, 8;
	@!%p1 bra SKIPV;
	shl.b32 %r14, %r5, 4;
	add.s32 %r15, %r4, %r14;
	ld.global.v4.u32 {%r16, %r17, %r18, %r19}, [%r15];
	add.s32 %r16, %r16, 1;
	add.s32 %r17, %r17, 1;
	add.s32 %r18, %r18, 1;
	add.s32 %r19, %r19, 1;
	add.s32 %r20, %r3, %r14;
	st.global.v4.u32 [%r20+256], {%r16, %r17, %r18, %r19};
SKIPV:
	shl.b32 %r21, %r5, 1;
	add.s32 %r22, %r4, %r21;
	ld.global.u16 %rs1, [%r22];
	cvt.u32.u16 %r23, %rs1;
	st.global.u32 [%r8+384], %r23;
	ld.global.nc.u32 %r24, [%r7];
	xor.b32 %r25, %r24, 85;
	st.global.u32 [%r8+512], %r25;
	and.b32 %r26, %r5, 1;
	setp.eq.u32 %p2, %r26, 1;
	mov.u32 %r27, 1;
	mov.u32 %r28, 2;
	@%p2 st.global.u32 [%r8+640], %r27;
	@!%p2 st.global.u32 [%r8+640], %r28;
	ld.global.u8 %rs2, [%r7+3];
	cvt.u32.u16 %r29, %rs2;
	st.global.u32 [%r8+768], %r29;
	ret;
}

@ stdcall __cudaRegisterVar(ptr ptr ptr ptr long long long long)
@ stdcall __cudaRegisterTexture(ptr ptr ptr ptr long long long)
@ stdcall cudaMalloc(ptr long)
@ stdcall cudaFree(ptr)
@ stdcall cudaMallocHost(ptr long)
@ stdcall cudaFreeHost(ptr)
@ stdcall cudaMemcpy(ptr ptr long long)
@ stdcall cudaMemcpyAsync(ptr ptr long long long)
@ stdcall cudaMemcpyToSymbol(ptr ptr long long long)
@ stdcall cudaMemcpyToSymbolAsync(ptr ptr long long long long)
@ stdcall cudaMemcpyFromSymbol(ptr ptr long long long)
@ stdcall cudaMemset(ptr long long)
@ stdcall cudaConfigureCall(long long long long long long long long)
@ stdcall cudaSetupArgument(ptr long long)
@ stdcall cudaLaunch(ptr)
@ stdcall cudaCreateChannelDesc(long long long long long)
@ stdcall cudaBindTexture(ptr ptr ptr ptr long)
@ stdcall cudaUnbindTexture(ptr)
